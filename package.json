{
  "name": "dsh-plugin-list-search",
  "version": "0.1.0",
  "description": "Keyword search for the DeepSeek Harness Plugins page, adapted to the DSH NEXT 2.0.x measured (natural) header layout. · 给「插件」页按名称/描述/包名过滤已安装插件，适配 DSH NEXT 2.0.x 的测量式页头。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "author": "deepseekv41flash",
  "contributors": [
    {
      "name": "huangxp12",
      "url": "https://github.com/huangxp12/dsh-plugin-search"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseekv41flash/dsh-plugin-search.git"
  },
  "homepage": "https://github.com/deepseekv41flash/dsh-plugin-search#readme",
  "bugs": {
    "url": "https://github.com/deepseekv41flash/dsh-plugin-search/issues"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "scripts": {
    "check": "node --check lib/client.js && node --check lib/index.js",
    "test": "node test/unit.test.mjs && node test/dom.test.mjs",
    "prepublishOnly": "npm run check && npm test && npm pack --dry-run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "search",
    "plugin-manager",
    "dsh-next"
  ]
}
